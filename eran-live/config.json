{
  "_comment": "PROTO-ERAN v1 config (renamed from Eran 2026-07-15; the name 'Eran' is reserved for the full realized vision). ProtoEran learns ONLY from Iddo's VOICE (data.py). NEVER a book corpus.",
  "_data_comment": "Corpus is built live by data.py from voice-input sources; no static corpus_path.",

  "checkpoint_dir": "D:/CLAUDE/eran-live/checkpoints",
  "log_path": "D:/CLAUDE/eran-live/eran.log",
  "metrics_path": "D:/CLAUDE/eran-live/logs/metrics.jsonl",
  "watch_path": "D:/CLAUDE/eran-live/watch.log",
  "fleet_status_path": "D:/CLAUDE/fleet/eran_live_status.json",

  "model": {
    "vocab_size": 260,
    "block_size": 128,
    "n_layer": 4,
    "n_head": 4,
    "n_embd": 256,
    "dropout": 0.1
  },

  "train": {
    "batch_size": 16,
    "learning_rate": 3e-4,
    "min_lr": 3e-5,
    "warmup_steps": 200,
    "lr_decay_steps": 50000,
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "grad_clip": 1.0,
    "max_steps": 0,
    "checkpoint_interval": 200,
    "log_interval": 10,
    "reload_corpus_interval": 2000,
    "watch_interval_sec": 180,
    "val_split": 0.02
  },

  "gpu": {
    "device": "cuda",
    "vram_fraction": 0.18,
    "gpu_target_pct": 15,
    "step_sleep_ms": 60,
    "_sleep_comment": "step_sleep_ms is auto-tuned at runtime toward gpu_target_pct (mic always wins)."
  },

  "seed": 1337
}
