{
  "corpus": "~/coder-train/corpus/domain_jsonl",
  "replay-corpus": "~/coder-train/corpus/replay_jsonl",
  "replay": "0.10",
  "heldout-jsonl": "~/coder-base-logs/heldout.jsonl",
  "data-dir": "~/coder-train/data",
  "content-leak-check": 1,
  "corpus-require-path": 1,
  "replay-require-path": 0,
  "min-doc-tokens": 32,
  "pack-mode": "concat",
  "seq-len": 4096,
  "micro-batch": 1,
  "grad-accum": 128,
  "lr": 4e-05,
  "min-lr-ratio": 0.1,
  "warmup": 20,
  "max-steps": 1600,
  "weight-decay": 0.1,
  "beta1": 0.9,
  "beta2": 0.95,
  "eps": 1e-08,
  "clip": 1.0,
  "precision": "master-fp32",
  "mem-frac": 0.85,
  "seed": 1337,
  "attn": "sdpa",
  "ckpt-dir": "~/coder-train/ckpt2",
  "save-every": 20,
  "keep-ckpt": 2,
  "log-every": 1,
  "save-hf-every": 200
}
