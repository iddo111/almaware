  },
  "stale_sec": {
    "type": "int",
    "min": 5,
    "max": 120
  },
  "hotkey_pause": {
    "type": "str"
  },
  "auto_enter": {
    "type": "bool"
  },
  "clipboard_restore": {
    "type": "bool"
  },
  "extra_avoid": {
    "type": "list[str]"
  },
  "corpus_capture": {
    "type": "bool"
  },
  "owner_gate_typing": {
    "type": "bool"
  },
  "lang_hint": {
    "type": "str",
