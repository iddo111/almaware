{
  "revision": {
    "type": "int",
    "min": 0
  },
  "mic_name": {
    "type": "str"
  },
  "server_url": {
    "type": "url",
    "fleet_hosts": [
      "127.0.0.1",
      "<lan-ip>",
      "<lan-ip>"
    ]
  },
  "auth_token_file": {
    "type": "str"
  },
  "gate_rms": {
