{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.alma/studio/job.schema.json",
  "title": "ALMA Studio shot job",
  "type": "object",
  "required": ["project_id", "shot_id", "version", "intent", "model_id", "model_revision", "model_license", "worker_class", "workflow_id", "workflow_sha256", "seed", "width", "height", "fps", "frames", "color_pipeline", "acceptance_tests", "status", "blockers"],
  "properties": {
    "project_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "shot_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "version": {"type": "integer", "minimum": 1},
    "intent": {"type": "string", "minLength": 1},
    "inputs": {"type": "array"},
    "continuity_refs": {"type": "array", "items": {"type": "string"}},
    "model_id": {"type": "string"},
    "model_revision": {"type": "string"},
    "model_license": {"type": "string"},
    "worker_class": {"enum": ["brain", "image-fast", "image-quality-and-text", "audio-video-primary", "video-fast-fallback", "video-quality-fallback", "music", "tts-and-voice", "finishing"]},
    "workflow_id": {"type": "string"},
    "workflow_sha256": {"type": "string"},
    "seed": {"type": "integer", "minimum": 0},
    "prompt": {"type": "string"},
    "negative_prompt": {"type": "string"},
    "width": {"type": "integer", "minimum": 64},
    "height": {"type": "integer", "minimum": 64},
    "fps": {"type": "number", "exclusiveMinimum": 0},
    "frames": {"type": "integer", "minimum": 1},
    "duration_s": {"type": "number", "exclusiveMinimum": 0},
    "color_pipeline": {"type": "string"},
    "audio_spec": {"type": "object"},
    "output_paths": {"type": "array", "items": {"type": "string"}},
    "provenance_path": {"type": "string"},
    "acceptance_tests": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "status": {"enum": ["VERIFIED", "ACTIVE", "BLOCKED", "PLANNED", "EXPERIMENTAL", "UNKNOWN", "DONE"]},
    "blockers": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
