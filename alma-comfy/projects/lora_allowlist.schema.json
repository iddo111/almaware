{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.alma/studio/lora_allowlist.schema.json",
  "title": "ALMA Studio per-project LoRA allowlist",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "approved_by", "approved_at", "loras"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "approved_by": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "format": "date-time"},
    "loras": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "enabled", "node", "repo_id", "revision", "source_file", "bytes", "sha256", "license", "compatible_base_assets"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
          "enabled": {"type": "boolean"},
          "node": {"const": "dgx3"},
          "repo_id": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
          "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "source_file": {"type": "string", "pattern": "^[^\\\\]+\\.safetensors$"},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "url", "commercial_use"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "url": {"type": "string", "format": "uri"},
              "commercial_use": {"enum": ["allowed", "forbidden", "conditional"]}
            }
          },
          "compatible_base_assets": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "trigger_words": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
